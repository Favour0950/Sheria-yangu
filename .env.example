DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Africa's Talking — SMS/OTP.
# Sandbox testing: AT_USERNAME=sandbox + your Sandbox app's API key.
# Real KamiLimu buildathon credentials (from Mark Tanui's SMS API email):
#   AT_USERNAME=buildathon-sms
#   AT_API_KEY=<the real key from that email — never commit the real value>
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-key-here

# Shared shortcode (20880) as the sending "from" — leave unset until confirmed
# with Mark whether outbound sends need it for two-way SMS replies to route
# correctly. See src/sms.py's AT_SENDER_ID comment.
AT_SENDER_ID=

# SendGrid — email notifications
SENDGRID_API_KEY=your-sendgrid-key-here
SENDGRID_FROM_EMAIL=notifications@sheriayangu.example

# Postgres — local for now, swap this one value for the DigitalOcean droplet's
# connection string later; schema/code don't change. See docs/postgres-setup.md.
DATABASE_URL=postgresql://sheria_user:your-local-password@localhost:5432/sheria_yangu
# ^ this must match whatever password you actually set with CREATE USER / ALTER ROLE —
# if you change the Postgres password, update it here too or the app can't connect.

# Auth — phone-number hashing pepper + JWT signing secret. Generate real random
# values for these (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# and never reuse the placeholders below, even locally.
PEPPER=generate-your-own-random-pepper-value
JWT_SECRET=generate-your-own-random-jwt-secret

# Set to "true" locally to skip real SMS sending during OTP testing — the
# /api/auth/request-otp response will include the code directly instead of
# texting it, so you can test the full register/verify flow without the
# Africa's Talking network issue blocking you. MUST be unset/false in any
# real deployment — this bypasses the whole point of an OTP if left on.
SMS_DEV_MODE=true

# Shared admin password for the /admin.html review dashboard — pick a real
# value, never leave as a common/guessable word.
ADMIN_PASSWORD=your-admin-password-here

# Real phone number (+2547...) that gets a text when the scheduled scraper
# run (src/run_scrapers_and_notify.py, cron) finds a new bill. Leave unset to
# run the scrapers on schedule without any SMS step — nothing breaks, it's
# just silent.
ADMIN_NOTIFY_PHONE=