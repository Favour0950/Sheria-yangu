DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Africa's Talking — SMS/OTP (use username "sandbox" until you have a paid account)
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-key-here

# SendGrid — email notifications
SENDGRID_API_KEY=your-sendgrid-key-here
SENDGRID_FROM_EMAIL=notifications@sheriayangu.example

# Postgres — local for now, swap this one value for the DigitalOcean droplet's
# connection string later; schema/code don't change. See docs/postgres-setup.md.
DATABASE_URL=postgresql://sheria_user:your-local-password@localhost:5432/sheria_yangu
# ^ this must match whatever password you actually set with CREATE USER / ALTER ROLE —
# if you change the Postgres password, update it here too or the app can't connect.